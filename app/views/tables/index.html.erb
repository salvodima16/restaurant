<div class="position-relative p-3 w-100">
  <div class="position-absolute start-20">
    <div>
      <h1>Tables</h1>
    </div>
    <br>
    <div>
      <div class="card" style="width: 18rem;">
        <ul class="list-group list-group-flush">
          <% @tables.each do |table| %>
            <li class="list-group-item"><%= link_to table.id, table %></li>
          <% end %>
        </ul>
      </div>
    </div>
    <br>
    <div class>
      <%= link_to "New Table", new_table_path %>
    </div>
  </div>
</div>

