<div class="position-relative p-3 w-100">
  <h1><%= @dish.name %></h1>

  <p>Price: €<%= @dish.price %></p>

  <ul>
    <li><%= link_to "Edit", edit_dish_path(@dish) %></li>
    <li><%= link_to "Destroy", dish_path(@dish), data: {
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure?"
                    } %></li>
  </ul>

  <h2> Ingredients </h2>
  <br>
  <ul>
    <% @ingredients.each do |ingredient| %>
      <li>
        <%= ingredient.name %>: <%= ingredient.quantity %>kg
      </li>
    <% end %>
  </ul>


  <%= link_to "Add ingredient", new_quantity_path %>

</div>