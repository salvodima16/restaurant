<h1><%= @dish.name %></h1>

<p>€<%= @dish.price %></p>

<ul>
  <li><%= link_to "Edit", edit_ingredient_path(@dish) %></li>
  <li><%= link_to "Destroy", ingredient_path(@dish), data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure?"
                  } %></li>
</ul>

<h2> Ingredients </h2>

<ul>
  <% @ingredients.each do |ingredient| %>
    <li>
      <p><%= ingredient.name %>: <%= ingredient.quantity %>kg</p>
    </li>
  <% end %>
</ul>


<li><%= link_to "Add ingredient", new_quantity_path %></li>