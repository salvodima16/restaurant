<div class="p-3 w-100">

  <h1>Order: <%= @order.number %></h1>

  <p><%= @order.name %></p>
  <p><%= @order.people %> person.</p>

  <h2>Dishes</h2>

  <ul>
    <% @dishes.each do |dish| %>
      <li>
        <%= dish.name %>: <%= dish.quantity %>pcs.
      </li>
    <% end %>
  </ul>

  <%= link_to "Add Dish", new_paper_row_path %>
</div>